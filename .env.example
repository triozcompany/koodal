# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# then fill in real values. .env.local is gitignored — never commit it.
# On a deploy platform (Vercel, etc.), set these same keys as project
# environment variables instead of shipping a .env file.

# Google Gemini — used for AI report analysis (lib/domain/analyze.ts).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=example_gemini_api_key

# Firebase Admin SDK service account — used for server-side writes
# (server/actions/*.ts via lib/firebase/admin.ts).
#
# Locally, lib/firebase/admin.ts prefers a JSON key file at:
#   secret/<project-id>-firebase-adminsdk-*.json
# (see secret/service-account.example.json for the expected shape — the
# secret/ folder itself is gitignored, so the real file never gets committed).
#
# On a deploy platform where you can't ship that file, set this env var
# instead: paste the ENTIRE service-account JSON as a single-line string.
# If neither this var nor a secret/*.json file is present, admin.ts falls
# back to Application Default Credentials (gcloud auth application-default
# login), which only works for local development.
FIREBASE_SERVICE_ACCOUNT_JSON=example_paste_the_full_service_account_json_here

# Firebase client (web) config — NOT secret, already committed as literal
# values in lib/firebase/client.ts (Firebase web API keys are safe to expose;
# access is enforced by Firestore security rules, not by hiding this key).
# Only relevant if you point this app at a different Firebase project.
