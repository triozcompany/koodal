# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# then fill in real values. .env.local is gitignored — never commit it.
# On a deploy platform (Vercel, etc.), set these same keys as project
# environment variables instead of shipping a .env file.

# Google Gemini — used for AI report analysis (lib/domain/analyze.ts).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=example_gemini_api_key

# Firebase Admin SDK service account — used for server-side writes
# (server/actions/*.ts via lib/firebase/admin.ts). lib/firebase/admin.ts
# tries these in order:
#   1. FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#      (below) — the three plain fields pulled straight from the service-
#      account JSON. Preferred on hosts like Vercel: no reassembling/
#      escaping a whole JSON file into one env var value.
#   2. FIREBASE_SERVICE_ACCOUNT_JSON — the entire service-account JSON as
#      a single-line string, if you'd rather set one var than three.
#   3. A local JSON key file at secret/<project-id>-firebase-adminsdk-*.json
#      (see secret/service-account.example.json for the shape — secret/ is
#      gitignored, so the real file never gets committed).
#   4. Application Default Credentials (gcloud auth application-default
#      login) — only works for local development.
FIREBASE_PROJECT_ID=example_project_id
FIREBASE_CLIENT_EMAIL=example_client_email@example_project_id.iam.gserviceaccount.com
# Paste the private_key field's value exactly as it appears in the JSON
# file, quotes and all (including the \n sequences and the
# -----BEGIN/END PRIVATE KEY----- lines).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nexample\n-----END PRIVATE KEY-----\n"

FIREBASE_SERVICE_ACCOUNT_JSON=example_paste_the_full_service_account_json_here

# Firebase client (web) config — NOT secret, already committed as literal
# values in lib/firebase/client.ts (Firebase web API keys are safe to expose;
# access is enforced by Firestore security rules, not by hiding this key).
# Only relevant if you point this app at a different Firebase project.

# Cloudinary — used for real report/evidence photo uploads (lib/cloudinary/upload.ts).
# Firebase Storage was skipped: it now requires the Blaze (pay-as-you-go) plan
# just to create a bucket, even for free-tier usage. Cloudinary's free tier
# (25GB storage/bandwidth, no card required) does not.
#
# Create a free account at https://cloudinary.com, then an UNSIGNED upload
# preset at Settings → Upload → Upload presets → Add upload preset (Signing
# mode: Unsigned). Both values below are safe to expose client-side — an
# unsigned preset is the access control, not a hidden key.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=example_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=example_unsigned_preset

# Cloudinary API key/secret — server-only, NEVER prefix these with NEXT_PUBLIC_.
# Used only by server/actions/cloudinary.ts to delete a photo that was
# uploaded during a report submission that then failed (the unsigned preset
# above can upload but deliberately can't delete — that needs a real signed
# request). Find these at Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_API_KEY=example_api_key
CLOUDINARY_API_SECRET=example_api_secret
